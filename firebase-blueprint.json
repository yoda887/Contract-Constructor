{
  "entities": {
    "clauses": {
      "title": "Clauses",
      "description": "Library of contract clauses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "folderId": { "type": "string" },
