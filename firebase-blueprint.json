        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "category", "titleRu", "contentRu"]
    },
    "templates": {
      "title": "Contract Templates",
      "description": "Templates for generating contracts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
